# PayPal Developer Dashboard > My Apps & Credentials > Sandbox app
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Set this after creating a PayPal webhook for the live backend URL
PAYPAL_WEBHOOK_ID=

# Used to verify simulated carrier delivery events
CARRIER_HMAC_SECRET=replace-with-a-long-random-secret

# Database for production persistence (Render Postgres, Neon, Supabase, etc.)
DATABASE_URL=postgresql://user:password@host:5432/safehaven_pay

# OpenAI-compatible AI provider. Leave blank only for the clearly-labelled fallback demo.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Optional telemetry provider; Postgres remains the fallback
ELASTIC_URL=
ELASTIC_API_KEY=

# Application security and browser access
JWT_SECRET=replace-with-a-long-random-secret
FRONTEND_ORIGIN=http://localhost:5176
DEMO_MODE=true
